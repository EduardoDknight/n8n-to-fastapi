# Shared secret the form provider uses to sign webhook bodies (HMAC-SHA256, hex)
WEBHOOK_SECRET=change-me
# Optional: enables Claude classification. Leave empty to use the offline rule-based classifier.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# SQLite file for idempotency + audit log
DB_PATH=leads.db
# Sink adapter: console | stub  (real Slack/Sheets/CRM adapters plug in behind the same interface)
SINKS=console
LOG_LEVEL=INFO
